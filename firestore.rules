rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/userProfiles/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function role() {
      return hasProfile() ? get(profilePath()).data.role : '';
    }

    function isAdmin() {
      return hasProfile() && role() == 'admin';
    }

    function isAccountant() {
      return hasProfile() && role() == 'accountant';
    }

    function isStaff() {
      return hasProfile() && role() == 'staff';
    }

    function canUseAccounts() {
      return isAdmin() || isAccountant();
    }

    function assignedToCurrentUser(task) {
      return hasProfile()
        && (
          (task.assignedTo is string
            && (task.assignedTo == request.auth.uid
              || (request.auth.token.email != null
                && task.assignedTo == request.auth.token.email)))
          || (task.assignedTo is list
            && (request.auth.uid in task.assignedTo
              || (request.auth.token.email != null
                && request.auth.token.email in task.assignedTo)))
        );
    }

    match /userProfiles/{uid} {
      allow read: if hasProfile();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (hasProfile()
          && request.auth.uid == uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'photo', 'phone', 'email', 'updatedAt']));
    }

    match /settings/{key} {
      allow read: if hasProfile() && key != 'gemini_config';
      allow write: if hasProfile()
        && key != 'gemini_config'
        && (
          isAdmin()
          || (isAccountant()
            && key in ['notifications', 'documents', 'refunds'])
          || (isStaff()
            && key in ['notifications', 'documents'])
          || ((isAccountant() || isStaff())
            && key == 'settings'
            && (
              (!exists(/databases/$(database)/documents/settings/settings)
                && request.resource.data.value is map
                && request.resource.data.value.keys().hasOnly(['theme']))
              || (exists(/databases/$(database)/documents/settings/settings)
                && resource.data.value is map
                && request.resource.data.value is map
                && request.resource.data.value.diff(resource.data.value)
                  .affectedKeys().hasOnly(['theme']))
            ))
          || ((isAccountant() || isStaff())
            && key.matches('last_reminder_date_.*'))
        );
    }

    match /makkahHotels/{id} {
      allow read, write: if isAdmin();
    }
    match /madinahHotels/{id} {
      allow read, write: if isAdmin();
    }
    match /flights/{id} {
      allow read, write: if isAdmin();
    }
    match /transports/{id} {
      allow read, write: if isAdmin();
    }
    match /visas/{id} {
      allow read, write: if isAdmin();
    }
    match /ziyarah/{id} {
      allow read, write: if isAdmin();
    }
    match /services/{id} {
      allow read, write: if isAdmin();
    }

    match /packages/{id} {
      allow read: if hasProfile();
      allow create, delete: if isAdmin();
      allow update: if canUseAccounts();
    }

    match /customers/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if canUseAccounts();
    }

    match /vendors/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if canUseAccounts();
    }

    match /payments/{id} {
      allow read, write: if canUseAccounts();
    }

    match /followups/{id} {
      allow read, write: if isAdmin();
    }

    match /tasks/{id} {
      allow read: if isAdmin()
        || (isAccountant() && assignedToCurrentUser(resource.data));
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isAccountant()
          && assignedToCurrentUser(resource.data)
          && request.resource.data.assignedTo == resource.data.assignedTo
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'done',
              'status',
              'stepsCompleted',
              'completedAt',
              'completedBy',
              'timerRunning',
              'timerStartTime',
              'timerStopped',
              'totalTime',
              'updatedAt'
            ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['completedBy'])
            || (request.resource.data.completedBy == request.auth.uid
              && request.resource.data.done == true)
          ));
      allow delete: if isAdmin();
    }

    match /images/{id} {
      allow read: if hasProfile();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
